{
  "name": "fracti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered Telegram Mini App for expense splitting and on-chain TON settlements",
  "license": "MIT-0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gui/react dev",
    "dev:bot": "pnpm --filter @fracti/bot dev",
    "build": "pnpm -r build",
    "build:gui": "pnpm --filter @gui/react build",
    "build:bot": "pnpm --filter @fracti/bot build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "cdk:synth": "pnpm --filter @infra/cdk synth",
    "cdk:deploy": "pnpm --filter @infra/cdk deploy",
    "cdk:bootstrap": "pnpm --filter @infra/cdk bootstrap",
    "setup": "pnpm --filter @infra/cdk setup",
    "report": "pnpm --filter @infra/cdk report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "cross-spawn": "^7.0.6",
    "grammy": "^1.39.3",
    "picocolors": "^1.1.0",
    "pnpm": "^10.28.0",
    "yaml": "^2.7.0"
  }
}
