{
  "name": "fracti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered Telegram Mini App for expense splitting and on-chain settlements",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:run && npm run test:e2e",
    "sam:build": "sam build",
    "sam:deploy": "sam deploy",
    "sam:deploy:guided": "sam deploy --guided",
    "sam:local": "sam local start-api --warm-containers EAGER",
    "sam:logs": "sam logs --tail",
    "deploy:frontend": "npm run build && aws s3 sync dist/ s3://$(aws cloudformation describe-stacks --stack-name fracti --query 'Stacks[0].Outputs[?OutputKey==`FrontendBucketName`].OutputValue' --output text) --delete",
    "webhook:set": "curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook\" -d \"url=$(aws cloudformation describe-stacks --stack-name fracti --query 'Stacks[0].Outputs[?OutputKey==`TelegramWebhookUrl`].OutputValue' --output text)\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.974.0",
    "@aws-sdk/client-dynamodb": "^3.974.0",
    "@aws-sdk/client-s3": "^3.974.0",
    "@aws-sdk/lib-dynamodb": "^3.974.0",
    "@aws-sdk/s3-request-presigner": "^3.974.0",
    "@grammyjs/validator": "^1.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@tonconnect/ui-react": "^2.3.1",
    "@twa-dev/sdk": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "^1.39.3",
    "hono": "^4.11.5",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-force-graph-2d": "^1.29.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.3",
    "react-router": "^7.12.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/aws-lambda": "^8.10.151",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.25.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
