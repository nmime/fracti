{
  "name": "fracti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered Telegram Mini App for expense splitting and on-chain settlements",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:run && npm run test:e2e",
    "sam:build": "sam build",
    "sam:deploy": "sam deploy",
    "sam:deploy:guided": "sam deploy --guided",
    "sam:local": "sam local start-api --warm-containers EAGER",
    "sam:logs": "sam logs --tail",
    "deploy:frontend": "npm run build && aws s3 sync dist/ s3://$(aws cloudformation describe-stacks --stack-name fracti --query 'Stacks[0].Outputs[?OutputKey==`FrontendBucketName`].OutputValue' --output text) --delete",
    "webhook:set": "curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook\" -d \"url=$(aws cloudformation describe-stacks --stack-name fracti --query 'Stacks[0].Outputs[?OutputKey==`TelegramWebhookUrl`].OutputValue' --output text)\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@grammyjs/validator": "^1.0.1",
    "@hono/zod-validator": "^0.5.0",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@tanstack/react-query": "^5.65.0",
    "@tonconnect/ui-react": "^2.0.12",
    "@twa-dev/sdk": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "^1.35.0",
    "hono": "^4.7.0",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-force-graph-2d": "^1.27.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^16.0.0",
    "react-router": "^7.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.2.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.3.5",
    "@vitest/coverage-v8": "^2.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^2.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
