# ===========================================
# Fracti Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------

# Node environment (development | production | test)
NODE_ENV=development

# DynamoDB table name (required)
TABLE_NAME=fracti-dev

# S3 bucket name for avatars (required)
S3_BUCKET_NAME=fracti-avatars-your-account-id-dev

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Mini App URL (t.me deeplink)
MINI_APP_URL=https://t.me/FractiBot/app

# App URL (CloudFront/domain URL for webApp buttons)
APP_URL=https://your-cloudfront-domain.cloudfront.net

# ---------------------------------------------
# AI Provider Configuration
# ---------------------------------------------
# Choose AI provider: bedrock (default) | anthropic | g4f
AI_PROVIDER=bedrock

# --- AWS Bedrock (default) ---
# AWS Bedrock model ID (must match app.yaml)
BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:057106046853:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS Region for Bedrock
AWS_REGION=us-east-1

# --- Anthropic API (self-hosted) ---
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# AI_MODEL=claude-3-5-haiku-20241022

# --- GPT4Free (free, no API key required!) ---
# G4F_BASE_URL=https://api.g4f.dev/v1
# G4F_MODEL=gpt-4o-mini
# Available models: gpt-4o, gpt-4o-mini, gpt-4.1, claude-3.5-sonnet, deepseek-v3
# Self-host: docker run -p 1337:1337 hlohaus789/g4f
# Then use: G4F_BASE_URL=http://localhost:1337/v1

# Set to true when running with SAM local
AWS_SAM_LOCAL=false

# ---------------------------------------------
# Frontend Configuration (Vite)
# ---------------------------------------------

# API base URL (use /api for production, full URL for local dev)
VITE_API_URL=http://localhost:3000/api

# TON Connect manifest URL
VITE_TONCONNECT_MANIFEST_URL=/tonconnect-manifest.json
