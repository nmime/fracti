# ===========================================
# Fracti Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------

# Node environment (development | production | test)
NODE_ENV=development

# DynamoDB table name (required)
TABLE_NAME=fracti-dev

# S3 bucket name for avatars (required)
S3_BUCKET_NAME=fracti-avatars-your-account-id-dev

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Mini App URL for Telegram
MINI_APP_URL=https://t.me/FractiBot/app

# AWS Bedrock model ID (must match app.yaml)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# AWS Region for Bedrock
AWS_REGION=us-east-1

# Set to true when running with SAM local
AWS_SAM_LOCAL=false

# ---------------------------------------------
# Frontend Configuration (Vite)
# ---------------------------------------------

# API base URL (use /api for production, full URL for local dev)
VITE_API_URL=http://localhost:3000/api

# TON Connect manifest URL
VITE_TONCONNECT_MANIFEST_URL=https://fracti.app/tonconnect-manifest.json
