auto-install-peers=true
shamefully-hoist=true
strict-peer-dependencies=false

# Allow native binary builds for bundlers
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@esbuild/linux-x64
onlyBuiltDependencies[]=@esbuild/linux-arm64
onlyBuiltDependencies[]=@rollup/rollup-linux-x64-gnu
onlyBuiltDependencies[]=@rollup/rollup-linux-arm64-gnu
onlyBuiltDependencies[]=lightningcss
